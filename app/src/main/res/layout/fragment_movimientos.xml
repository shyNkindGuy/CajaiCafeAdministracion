<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña Movimientos (4.3): ventas o gastos, uno a la vez (ver MovimientosFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movimientos"
        android:textColor="@color/textoMarca"
        android:fontFamily="serif" android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Lo que entra (ventas) y lo que sale (gastos), lo más reciente arriba."
        android:textColor="@color/textoSecundario"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/selectorMovimientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedButton="@+id/btnVerVentas"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerVentas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ventas"
            android:textColor="@color/textoMarca" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerGastos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gastos"
            android:textColor="@color/textoMarca" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- HistorialFragment (ventas) o GastosFragment, como fragment hijo. -->
    <FrameLayout
        android:id="@+id/contenedorMovimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />
</LinearLayout>
