<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Resumen del mes"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/cafeOscuro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spinnerMes"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Resultado -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:backgroundTint="#FFFFFF"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:gravity="center" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Utilidad neta" android:textSize="14sp" android:textColor="#555555" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvUtilidad" android:text="S/ 0.00" android:textSize="32sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvMargen" android:text="Margen: —" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:text="Ventas − costo del café vendido − gastos del mes" android:textSize="12sp" android:textColor="#757575" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ventas -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:backgroundTint="#E8F5E9"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Ventas" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvIngresos" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvCobrado" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvPorCobrar" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btnCuentasPorCobrar"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/cafeMedio"
                    android:text="Ver todas las cuentas por cobrar" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Costos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:backgroundTint="#FFF3E0"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Costos" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvCostoVendido" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSinCosto" android:text="" android:textSize="12sp" android:textColor="#757575" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvGastosMes" android:text="" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Lotes abiertos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" android:backgroundTint="#E0F2F1"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Lotes abiertos: ¿ya recuperé lo invertido?" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSinLotes" android:text="No hay lotes abiertos." android:textColor="#757575" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <!-- Una fila por lote, agregadas desde InicioFragment. -->
                <LinearLayout android:id="@+id/contenedorLotes" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="Lo invertido es el costeo del lote más los gastos registrados con ese lote; lo recuperado, todas sus ventas registradas." android:textSize="12sp" android:textColor="#757575" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
