<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Cuentas por cobrar"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/cafeOscuro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvTotalPorCobrar"
            android:text="Total por cobrar: S/ 0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Todas las ventas pendientes o con pago parcial, de la más antigua a la más nueva. El pago se registra en Historial (botón editar)."
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSinCuentas"
            android:text="Nadie te debe nada."
            android:textColor="#2E7D32"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Una fila (item_cuenta) por venta con saldo, agregadas desde CuentasPorCobrarActivity. -->
        <LinearLayout
            android:id="@+id/contenedorCuentas"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
