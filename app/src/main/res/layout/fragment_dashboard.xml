<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="16dp">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <!-- Pestaña Más (4.3): totales, atajos, reportes y la sesión. -->
        <TextView
            android:text="Más"
            android:fontFamily="serif" android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textoMarca"
            android:layout_height="wrap_content"  android:layout_width="match_parent"/>

        <TextView
            android:text="Bolsas vendidas y cobrado, de todas las fechas"
            android:textSize="12sp"
            android:textColor="@color/textoSecundario"
            android:layout_marginBottom="12dp"
            android:layout_height="wrap_content"  android:layout_width="match_parent"/>

        <LinearLayout
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/tarjetaNaranja">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tvTotalMedioKilo"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold" android:layout_height="wrap_content" android:layout_width="match_parent"/>
                    <TextView
                        android:text="Bolsas 1/2 kg"
                        android:textSize="14sp" android:layout_height="wrap_content" android:layout_width="match_parent"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/tarjetaCeleste">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tvTotalCuartoKilo"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold" android:layout_height="wrap_content" android:layout_width="match_parent"/>
                    <TextView
                        android:text="Bolsas 1/4 kg"
                        android:textSize="14sp" android:layout_height="wrap_content" android:layout_width="match_parent"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/tarjetaVerde"> <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:text="Total Pagado"
                android:textSize="14sp"
                android:textColor="@color/textoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvTotalDinero"
                android:text="S/ 0.00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/positivo"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnCuentasPorCobrarMas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/textoMarca"
            android:text="Cuentas por cobrar" />

        <Button
            android:id="@+id/btnRegistrarGasto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/cafeMedio"
            android:textColor="#FFFFFF"
            android:text="Registrar gasto" />

        <TextView
            android:text="Generar Reporte"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textStyle="bold" android:layout_height="wrap_content"  android:layout_width="match_parent"/>

        <RadioGroup
            android:id="@+id/rgTipoReporte"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbPorMes"
                android:text="Por mes"
                android:checked="true"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
            <RadioButton
                android:id="@+id/rbPorLote"
                android:text="Por lote"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </RadioGroup>

        <Spinner
            android:id="@+id/spinnerReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:text="Reporte interno (no es comprobante de pago). El PDF y el CSV (ventas y gastos) se guardan en Descargas y se pueden compartir."
            android:textSize="12sp"
            android:textColor="@color/textoSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnExportarPDF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generar PDF"
            android:backgroundTint="@color/cafeOscuro"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnExportarCSV"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/textoMarca"
            android:text="Exportar CSV (Excel / Sheets)" />

        <TextView
            android:id="@+id/tvSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:textColor="@color/textoSecundario"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCerrarSesion"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cerrar sesión"
            android:textColor="@color/textoMarca" />

    </LinearLayout>
</ScrollView>