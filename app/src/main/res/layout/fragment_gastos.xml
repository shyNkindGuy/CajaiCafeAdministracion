<?xml version="1.0" encoding="utf-8"?>
<!-- Movimientos → Gastos (ver GastosFragment). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnNuevoGasto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/cafeMedio"
            android:textColor="@android:color/white"
            android:text="Registrar gasto" />

        <TextView
            android:text="Mantén presionado un gasto para borrarlo."
            android:textSize="12sp"
            android:textColor="@color/textoSecundario"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSinGastos"
            android:text="Todavía no hay gastos registrados."
            android:textColor="@color/textoSecundario"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Filas agregadas desde GastosFragment. Un ListView dentro de un ScrollView solo mostraría una fila. -->
        <LinearLayout
            android:id="@+id/contenedorGastos"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
