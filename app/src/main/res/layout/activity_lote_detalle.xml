<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView android:id="@+id/tvDetCodigo" android:text="LOTE1-NOV2025" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/cafeOscuro" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tvDetFecha" android:text="Inicio: —" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvDetEstado" android:text="ABIERTO" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Costos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:backgroundTint="#FFF3E0"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Gastos del lote" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetPergamino" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetPilado" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetTostado" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetFlete" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetElectricidad" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetEmpaque" android:text="" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetTotalGastos" android:text="" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ventas / ganancia -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:backgroundTint="#E8F5E9"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Ventas y ganancia" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetVentaBruta" android:text="Ventas registradas: S/ 0.00" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetCobrado" android:text="Cobrado hasta hoy: S/ 0.00" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetGanancia" android:text="Ganancia parcial: S/ 0.00" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stock -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:backgroundTint="#E0F2F1"
            card_view:cardCornerRadius="12dp" card_view:cardElevation="3dp">
            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Stock de este lote" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                        <TextView android:id="@+id/tvDetStock12" android:text="0" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Bolsas 1/2 kg" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                        <TextView android:id="@+id/tvDetStock14" android:text="0" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Bolsas 1/4 kg" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/btnRegistrarEmpacado"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/cafeMedio" android:textColor="#FFFFFF"
                    android:text="Registrar empacado" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnCerrarLote"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="24dp"
            android:backgroundTint="@color/estadoPendiente" android:textColor="#FFFFFF"
            android:text="Cerrar lote" />

    </LinearLayout>
</ScrollView>
