<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Tema Material 3 con los colores de marca (tarea 4.1). DayNight: los mismos nombres de color
      toman su versión oscura de values-night/colors.xml, así que no hace falta otro tema para la noche.
    -->
    <style name="Base.Theme.CajaiCafeAdministracion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/marcaPrimario</item>
        <item name="colorOnPrimary">@color/marcaSobrePrimario</item>
        <item name="colorPrimaryContainer">@color/marcaContenedor</item>
        <item name="colorOnPrimaryContainer">@color/marcaSobreContenedor</item>
        <item name="colorSecondary">@color/marcaSecundario</item>
        <item name="colorOnSecondary">@color/marcaSobrePrimario</item>
        <!-- Chip elegido en la venta rápida (4.2): sin esto Material 3 lo pinta lila. -->
        <item name="colorSecondaryContainer">@color/marcaContenedor</item>
        <item name="colorOnSecondaryContainer">@color/marcaSobreContenedor</item>
        <item name="colorTertiary">@color/positivo</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorOnBackground">@color/texto</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/textoSecundario</item>
        <item name="colorOutline">@color/borde</item>
        <!-- Barras del sistema en café oscuro con íconos claros, en los dos modos. -->
        <item name="android:statusBarColor">@color/cafeProfundo</item>
        <item name="android:navigationBarColor">@color/cafeProfundo</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CajaiCafeAdministracion" parent="Base.Theme.CajaiCafeAdministracion" />

    <!-- Barra de abajo (4.3). Con 5 pestañas, "Movimientos" no entra con la letra de Material 3. -->
    <style name="TextoBarraNavegacion" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Píldora detrás del ícono elegido: café medio, para que el ícono blanco se vea (la crema de
         colorSecondaryContainer casi no se distingue del blanco). -->
    <style name="IndicadorBarraNavegacion" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cafeMedio</item>
    </style>
</resources>
