{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "productos": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      "$id": {
        "precio": { ".read": true },
        "ofertaCantidad": { ".read": true },
        "ofertaPrecio": { ".read": true }
      }
    },
    "ventas": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      ".indexOn": ["loteId", "fecha"]
    },
    "lotes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).val() === true"
    },
    "gastos": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).val() === true",
      ".indexOn": ["fecha", "loteId"],
      "$id": {
        ".validate": "newData.hasChildren(['fecha', 'categoria', 'monto', 'uid']) && newData.child('monto').isNumber() && newData.child('monto').val() > 0 && newData.child('uid').val() === auth.uid"
      }
    }
  }
}
